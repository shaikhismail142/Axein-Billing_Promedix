{
  "name": "axein-billing-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "AxEin Billing desktop launcher for Windows and macOS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:runtime": "npm --prefix .. run desktop:runtime",
    "dist": "electron-builder --publish never",
    "dist:win": "npm run prepare:runtime && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run prepare:runtime && electron-builder --mac --publish never",
    "dist:mac:x64": "npm run prepare:runtime && electron-builder --mac --x64 --publish never",
    "dist:mac:arm64": "npm run prepare:runtime && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "in.axein.billing",
    "productName": "AxEin Billing",
    "protocols": [
      {
        "name": "Axein Billing Activation",
        "schemes": ["axein-billing"]
      }
    ],
    "artifactName": "AxEin-Billing-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AxEin Billing"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "minimumSystemVersion": "11.0",
      "target": ["dmg", "zip"]
    }
  }
}
