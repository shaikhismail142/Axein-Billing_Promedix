DATABASE_URL=postgresql://app:app@db:5432/app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_KEY=minio
S3_SECRET=miniominiom

# ===== Licensing & Trial (offline) =====
# Enable/disable trial feature globally (hard switch)
TRIAL_ENABLED=true
# Trial length in days
TRIAL_DAYS=7
# Optional license grace period (minutes) for clock skew; app uses internal tolerance too
GRACE_DAYS=0

# Provide Ed25519 public keys (SPKI base64) as a JSON map.
# Generate with tools/license-keygen/init-keys.js; copy "publicKey_spki_base64" into this JSON.
# You can support multiple kids for key rotation, e.g. ed25519-v1, ed25519-v2.
LICENSE_PUBKEYS_JSON={"ed25519-v1":"<PASTE_SPki_BASE64_HERE>"}

# ===== Activation gate (existing OTP flow compatibility) =====
# When true, middleware enforces activation. It will allow access if EITHER:
# 1) OTP activation ok (your existing /api/activation/status returns { ok: true }), OR
# 2) License status ok (licensed or active trial via /api/license/status)
NEXT_PUBLIC_APP_ACTIVATION_REQUIRED=true
APP_ACTIVATION_REQUIRED=true

# ===== Base URL (already in your project, listed here for completeness) =====
# Used by some parts of the app when constructing absolute URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
